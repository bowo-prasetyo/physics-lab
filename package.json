{
  "name": "physica",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive experiments about space, time and motion, from everyday motion to relativity and cosmology, for high-school and undergraduate learners.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:catalogue": "UPDATE_README=1 vitest run src/readme-catalogue.test.ts",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:localization:runtime": "vitest run src/i18n/runtime-localization-audit.test.ts src/i18n/interactive-localization-audit.test.ts src/i18n/webgl-localization-audit.test.ts",
    "audit:localization:webgl": "vitest run src/i18n/webgl-localization-audit.test.ts",
    "audit:localization:interactive": "vitest run src/i18n/interactive-localization-audit.test.ts"
  },
  "dependencies": {
    "katex": "0.18.11",
    "three": "0.187.0",
    "vue": "3.5.46",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.7",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
